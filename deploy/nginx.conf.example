# Portable single-ingress template. Replace .invalid names and certificate paths.
# Validate with nginx -t on the approved host before activation.
worker_processes auto;
events { worker_connections 1024; }
http {
    include mime.types;
    default_type application/octet-stream;
    server_tokens off;
    # No client IPs, paths, query strings, cookies, headers or request bodies.
    log_format kivo escape=json '{"status":$status,"method":"$request_method",'
        '"duration_s":$request_time,"request_id":"$request_id"}';
    access_log /var/log/nginx/kivo-access.log kivo;
    # Standard nginx error messages can include complete query strings.
    # Diagnose upstream failures through status metrics and sanitized Django logs.
    error_log /var/log/nginx/kivo-error.log crit;
    limit_req_zone $binary_remote_addr zone=kivo_login:1m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=kivo_register:1m rate=3r/m;
    limit_req_status 429;
    limit_req_log_level notice;
    client_max_body_size 64k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    send_timeout 30s;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    # Never replay a financial write on another upstream after an ambiguous result.
    proxy_next_upstream off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Connection "";
    proxy_http_version 1.1;

    server { listen 80 default_server; server_name _; return 444; }
    server {
        listen 80;
        server_name web.example.invalid api.example.invalid;
        return 308 https://$host$request_uri;
    }
    server {
        listen 443 ssl default_server;
        ssl_reject_handshake on;
    }
    server {
        listen 443 ssl;
        server_name web.example.invalid;
        ssl_certificate /etc/kivo/tls/web-fullchain.pem;
        ssl_certificate_key /etc/kivo/tls/web-key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
        location = /api/v1/auth/login/ {
            limit_req zone=kivo_login burst=4 nodelay;
            proxy_pass http://127.0.0.1:8000;
        }
        location = /api/v1/auth/register/ {
            limit_req zone=kivo_register burst=2 nodelay;
            proxy_pass http://127.0.0.1:8000;
        }
        # Match Next's optional trailing slash without an unrestricted bypass.
        location = /api/v1/auth/login {
            limit_req zone=kivo_login burst=4 nodelay;
            proxy_pass http://127.0.0.1:8000;
        }
        location = /api/v1/auth/register {
            limit_req zone=kivo_register burst=2 nodelay;
            proxy_pass http://127.0.0.1:8000;
        }
        # Preserve browser URLs, JSON/session/CSRF contracts; ingress sends API
        # requests directly to Django, retaining a trustworthy client identity.
        location = /api/v1/health/db/ { deny all; }
        location /api/v1/ { proxy_pass http://127.0.0.1:8000; }
        location / { proxy_pass http://127.0.0.1:3000; }
    }
    server {
        listen 443 ssl;
        server_name api.example.invalid;
        ssl_certificate /etc/kivo/tls/api-fullchain.pem;
        ssl_certificate_key /etc/kivo/tls/api-key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        location ~ ^/api/v1/auth/login/?$ {
            limit_req zone=kivo_login burst=4 nodelay;
            proxy_pass http://127.0.0.1:8000;
        }
        location ~ ^/api/v1/auth/register/?$ {
            limit_req zone=kivo_register burst=2 nodelay;
            proxy_pass http://127.0.0.1:8000;
        }
        # Operator-only surfaces. Access over a separately authorized tunnel.
        location /admin/ { deny all; }
        location = /api/schema/ { deny all; }
        location = /api/docs/ { deny all; }
        location = /api/redoc/ { deny all; }
        location = /api/v1/health/db/ {
            allow 127.0.0.1;
            allow ::1;
            deny all;
            proxy_pass http://127.0.0.1:8000;
        }
        location /api/v1/ { proxy_pass http://127.0.0.1:8000; }
        location / { return 404; }
    }
}
