# Operator template, NOT a usable environment. Replace every placeholder privately.
# Production does not read the development .env. No secrets in source or argv.
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_PRIVATE_RANDOM_VALUE_AT_LEAST_50_CHARACTERS
ALLOWED_HOSTS=api.example.invalid,web.example.invalid
CSRF_TRUSTED_ORIGINS=https://web.example.invalid
SECURE_SSL_REDIRECT=True
# Gunicorn accepts scheme headers only from loopback. No Django header trust override.
# Only for this single, loopback-only nginx ingress, which REPLACES X-Forwarded-For.
AUTH_TRUSTED_PROXY_HOPS=1
# Obtain official custom runtime-role URI and CA from the approved Supabase project.
# Percent-encode special characters; supply sslrootcert if needed for verify-full.
SUPABASE_DB_URL=REPLACE_WITH_PRIVATE_RUNTIME_URI
DJANGO_LOG_LEVEL=INFO
