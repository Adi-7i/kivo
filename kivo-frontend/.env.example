# ==============================================================================
# Kivo Frontend Environment Configuration Template (.env.example)
#
# Copy this file to .env.local for local development.
# NEVER commit .env.local to source control.
# ==============================================================================

# Server-only Django origin. Browser API calls use this Next.js site's /api/v1/.
# Do not put database URLs, credentials, or session secrets in NEXT_PUBLIC_*.
DJANGO_API_ORIGIN=http://127.0.0.1:8000
# Django CSRF_TRUSTED_ORIGINS must include the actual frontend origin.
# For Playwright, include http://localhost:3001 via backend process environment.
