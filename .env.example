# ==============================================================================
# Kivo Backend Environment Configuration Template (.env.example)
#
# Copy this file to .env and populate with your real local/remote credentials.
# NEVER commit the real .env file into source control.
# ==============================================================================

# Django Core Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-50-characters
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database — Remote Supabase PostgreSQL (CONFIRMED)
# Obtain this URL from your Supabase Dashboard:
# Project Settings -> Database -> Connection string (URI)
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
# Note: Use Direct connection (port 5432) or Session Pooler (port 5432).
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# CORS & CSRF (Development defaults)
# No CORS middleware is installed. Use a same-origin reverse proxy for the web
# client. CSRF trust alone does not enable cross-origin browser requests.
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
